# 复制本文件为 .env，填入你自己的配置。.env 已在 .gitignore 中，不会被提交。

# ===== 文本模型（代码分析 / 对话），按 OpenAI 兼容格式调用 =====
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=sk-your-deepseek-key
MODEL_TIMEOUT_MS=45000
MODEL_TEMPERATURE=0.1
# 置 1 时进入演示模式，不调用真实模型
MODEL_MOCK=0

# ===== 多模态（图片识别 / 语音转写，千问 DashScope） =====
MM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MM_VISION_MODEL=qwen3-vl-plus
MM_AUDIO_MODEL=qwen3.8-omni-flash
MM_API_KEY=sk-your-dashscope-key

# ===== 登录 =====
# 格式 user:pass，多个账号用逗号分隔；留空则不启用登录
APP_USERS=admin:change-me
# 旧版单密码方式，APP_USERS 优先
APP_PASSWORD=

# ===== 服务端口 =====
# 注意：vite.config.ts 里开发代理默认指向 8787，改了 APP_PORT 记得同步改一下
APP_HOST=0.0.0.0
APP_PORT=8080

# ===== GitHub 仓库导入 =====
# 可选：配置后匿名限流（每小时 60 次）不再受限，也能读私有仓库
GITHUB_TOKEN=
# 可选：国内网络访问 raw.githubusercontent.com 不通时走镜像
GITHUB_PROXY=https://gh-proxy.com/
# 置 1 强制所有 GitHub 请求都走镜像
GITHUB_FORCE_PROXY=0

# ===== Python 格式化（可选） =====
# 指定 Python 解释器路径；不填则自动探测，找不到就跳过 Python 格式化
PYTHON_BIN=
